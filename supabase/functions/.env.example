# Server-side only. Copy to supabase/functions/.env.local; never into Vite env files.
# Hosted: copy the dashboard's transaction pooler host/port; use the restricted login.
PREBI_DATABASE_URL=postgresql://prebi_edge_login.PROJECT_REF:ENCODED_PASSWORD@YOUR_POOLER_HOST:6543/postgres
PREBI_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Optional PEM CA certificate for hosted TLS; actual multiline content, not a file path.
PREBI_DATABASE_CA_CERT=
# Exact origins, without paths or trailing slashes. Include only origins actually needed.
PREBI_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://nguyenhongquy.github.io
